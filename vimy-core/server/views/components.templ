package views

import (
	"encoding/json"
	"fmt"
	"sort"
	"strings"
	"time"
	"github.com/nstehr/vimy/vimy-core/agent"
	"github.com/nstehr/vimy/vimy-core/rules"
	"github.com/nstehr/vimy/vimy-core/store"
)

templ WeightBar(label string, value float64) {
	<div class="flex items-center gap-3 text-sm">
		<span class="w-28 text-gray-400 truncate" title={ label }>{ label }</span>
		<div class="flex-1 bg-gray-800 rounded-full h-3 overflow-hidden">
			<div
				class="h-full rounded-full bg-emerald-500"
				style={ fmt.Sprintf("width: %.0f%%", value*100) }
			></div>
		</div>
		<span class="w-12 text-right font-mono text-gray-300">{ fmt.Sprintf("%.2f", value) }</span>
	</div>
}

templ DoctrineCard(rec *agent.DoctrineRecord) {
	<div id="doctrine-current" hx-get="/api/doctrine/current" hx-trigger="every 5s" hx-swap="outerHTML">
		if rec == nil {
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-gray-500">
				No doctrine generated yet. Waiting for game connection...
			</div>
		} else {
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-6">
				<div class="flex items-start justify-between">
					<div>
						<h3 class="text-xl font-semibold text-emerald-400">{ rec.Doctrine.Name }</h3>
						<p class="text-gray-400 mt-1 text-sm max-w-2xl">{ rec.Doctrine.Rationale }</p>
					</div>
					<div class="flex flex-col items-end gap-1">
						<span class="text-sm text-gray-500 font-mono">Tick { fmt.Sprintf("%d", rec.Tick) }</span>
						if rec.HasEnemyIntel {
							<span class="text-xs font-medium text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded-full">Enemy Located</span>
						} else {
							<span class="text-xs font-medium text-gray-500 bg-gray-800 px-2 py-0.5 rounded-full">No Enemy Intel</span>
						}
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
					<!-- Economy & Tech -->
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Economy &amp; Tech</h4>
						@WeightBar("Economy", rec.Doctrine.EconomyPriority)
						@WeightBar("Tech", rec.Doctrine.TechPriority)
					</div>

					<!-- Combat Composition -->
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Combat Composition</h4>
						@WeightBar("Infantry", rec.Doctrine.InfantryWeight)
						@WeightBar("Vehicle", rec.Doctrine.VehicleWeight)
						@WeightBar("Air", rec.Doctrine.AirWeight)
						@WeightBar("Naval", rec.Doctrine.NavalWeight)
					</div>

					<!-- Aggression & Defense -->
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Aggression &amp; Defense</h4>
						@WeightBar("Aggression", rec.Doctrine.Aggression)
						@WeightBar("Ground Def", rec.Doctrine.GroundDefensePriority)
						@WeightBar("Air Def", rec.Doctrine.AirDefensePriority)
					</div>

					<!-- Squad Sizes -->
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Squad Sizes</h4>
						<div class="flex gap-6 text-sm">
							<div class="text-gray-400">Ground: <span class="text-gray-100 font-mono">{ fmt.Sprintf("%d", rec.Doctrine.GroundAttackGroupSize) }</span></div>
							<div class="text-gray-400">Air: <span class="text-gray-100 font-mono">{ fmt.Sprintf("%d", rec.Doctrine.AirAttackGroupSize) }</span></div>
							<div class="text-gray-400">Naval: <span class="text-gray-100 font-mono">{ fmt.Sprintf("%d", rec.Doctrine.NavalAttackGroupSize) }</span></div>
						</div>
					</div>

					<!-- Special -->
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Special</h4>
						@WeightBar("Scout", rec.Doctrine.ScoutPriority)
						@WeightBar("Specialist Inf", rec.Doctrine.SpecializedInfantryWeight)
						@WeightBar("Superweapon", rec.Doctrine.SuperweaponPriority)
						@WeightBar("Capture", rec.Doctrine.CapturePriority)
						@WeightBar("Transport", rec.Doctrine.TransportAssault)
					</div>

					<!-- Preferences -->
					<div class="space-y-2">
						<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Preferences</h4>
						if len(rec.Doctrine.PreferredInfantry) > 0 {
							<div class="text-sm"><span class="text-gray-400">Infantry:</span> <span class="text-gray-200">{ strings.Join(rec.Doctrine.PreferredInfantry, ", ") }</span></div>
						}
						if len(rec.Doctrine.PreferredVehicle) > 0 {
							<div class="text-sm"><span class="text-gray-400">Vehicle:</span> <span class="text-gray-200">{ strings.Join(rec.Doctrine.PreferredVehicle, ", ") }</span></div>
						}
						if len(rec.Doctrine.PreferredAircraft) > 0 {
							<div class="text-sm"><span class="text-gray-400">Aircraft:</span> <span class="text-gray-200">{ strings.Join(rec.Doctrine.PreferredAircraft, ", ") }</span></div>
						}
						if len(rec.Doctrine.PreferredNaval) > 0 {
							<div class="text-sm"><span class="text-gray-400">Naval:</span> <span class="text-gray-200">{ strings.Join(rec.Doctrine.PreferredNaval, ", ") }</span></div>
						}
						if len(rec.Doctrine.PreferredInfantry) == 0 && len(rec.Doctrine.PreferredVehicle) == 0 && len(rec.Doctrine.PreferredAircraft) == 0 && len(rec.Doctrine.PreferredNaval) == 0 {
							<div class="text-sm text-gray-500">No unit preferences set</div>
						}
					</div>
				</div>
			</div>
		}
	</div>
}

// categoryOrder defines the display order for rule categories.
var categoryOrder = map[string]int{
	"setup":          0,
	"economy":        1,
	"power":          2,
	"tech":           3,
	"produce_building": 4,
	"produce_defense": 5,
	"produce_infantry": 6,
	"produce_vehicle": 7,
	"produce_air":    8,
	"produce_naval":  9,
	"combat":         10,
	"micro":          11,
	"recon":          12,
	"capture":        13,
	"superweapon":    14,
}

func sortTypeCounts(tcs []agent.TypeCount) []agent.TypeCount {
	out := make([]agent.TypeCount, len(tcs))
	copy(out, tcs)
	sort.Slice(out, func(i, j int) bool {
		if out[i].Count != out[j].Count {
			return out[i].Count > out[j].Count
		}
		return out[i].Type < out[j].Type
	})
	return out
}

func countOf(tcs []agent.TypeCount, typeName string) int {
	for _, tc := range tcs {
		if tc.Type == typeName {
			return tc.Count
		}
	}
	return 0
}

func groupAndSortRules(summaries []rules.RuleSummary) []categoryGroup {
	grouped := make(map[string][]rules.RuleSummary)
	for _, s := range summaries {
		grouped[s.Category] = append(grouped[s.Category], s)
	}
	var groups []categoryGroup
	for cat, rs := range grouped {
		groups = append(groups, categoryGroup{Category: cat, Rules: rs})
	}
	sort.Slice(groups, func(i, j int) bool {
		oi, oki := categoryOrder[groups[i].Category]
		oj, okj := categoryOrder[groups[j].Category]
		if !oki { oi = 100 }
		if !okj { oj = 100 }
		if oi != oj { return oi < oj }
		return groups[i].Category < groups[j].Category
	})
	return groups
}

type categoryGroup struct {
	Category string
	Rules    []rules.RuleSummary
}

templ RulesPanel(summaries []rules.RuleSummary) {
	<div id="rules-panel" hx-get="/api/rules" hx-trigger="every 10s" hx-swap="outerHTML">
		if len(summaries) == 0 {
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-gray-500">
				No rules compiled yet. Waiting for doctrine generation...
			</div>
		} else {
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-2">
				<div class="flex items-center gap-3 mb-4">
					<h2 class="text-lg font-semibold text-gray-200">Compiled Rules</h2>
					<span class="text-xs font-medium text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded-full">{ fmt.Sprintf("%d", len(summaries)) } rules</span>
				</div>
				for _, g := range groupAndSortRules(summaries) {
					<details class="group border border-gray-800 rounded-lg">
						<summary class="flex items-center justify-between cursor-pointer px-4 py-2 hover:bg-gray-800/50 rounded-lg">
							<span class="text-sm font-medium text-gray-300">{ g.Category }</span>
							<span class="text-xs text-gray-500 bg-gray-800 px-2 py-0.5 rounded-full">{ fmt.Sprintf("%d", len(g.Rules)) }</span>
						</summary>
						<div class="px-4 pb-3 space-y-2">
							for _, r := range g.Rules {
								<div class="flex items-start gap-3 text-sm border-t border-gray-800/50 pt-2">
									<span class="font-mono text-xs text-gray-500 w-8 text-right shrink-0">{ fmt.Sprintf("%d", r.Priority) }</span>
									<div class="flex-1 min-w-0">
										<div class="flex items-center gap-2">
											<span class="text-gray-200">{ r.Name }</span>
											if r.Exclusive {
												<span class="text-xs font-medium text-amber-400 bg-amber-400/10 px-1.5 py-0 rounded">excl</span>
											}
										</div>
										if r.Because != "" {
											<p class="mt-0.5 text-xs text-gray-400 italic">{ r.Because }</p>
										}
										<code class="block mt-1 text-xs text-gray-500 break-all">{ r.ConditionSrc }</code>
									</div>
								</div>
							}
						</div>
					</details>
				}
			</div>
		}
	</div>
}

templ BattlefieldPanel(status *agent.BattlefieldStatus) {
	<div id="battlefield-panel" hx-get="/api/battlefield" hx-trigger="every 5s" hx-swap="outerHTML">
		if status == nil {
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-gray-500">
				No battlefield data yet. Waiting for game connection...
			</div>
		} else {
			<div class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-6">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
					<!-- Our Losses -->
					<div class="space-y-3">
						<h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Our Losses</h3>
						<div class="grid grid-cols-3 gap-4">
							@lossCounter("Infantry", status.InfantryLost)
							@lossCounter("Vehicles", status.VehiclesLost)
							@lossCounter("Aircraft", status.AircraftLost)
							@lossCounter("Naval", status.NavalLost)
						</div>
					</div>

					<!-- Enemy Buildings -->
					<div class="space-y-3">
						<h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Enemy Buildings</h3>
						if len(status.EnemyBuildingsSeen) == 0 && len(status.EnemyBuildings) == 0 {
							<div class="text-sm text-gray-600">No enemy buildings observed</div>
						} else {
							<div class="space-y-1">
								for _, tc := range sortTypeCounts(status.EnemyBuildingsSeen) {
									@enemyTypeRow(tc.Type, tc.Count, countOf(status.EnemyBuildings, tc.Type))
								}
							</div>
						}
					</div>

					<!-- Enemy Troops (spans full width) -->
					<div class="md:col-span-2 space-y-3">
						<h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Enemy Troops</h3>
						if len(status.EnemyUnitsSeen) == 0 && len(status.EnemyUnits) == 0 {
							<div class="text-sm text-gray-600">No enemy troops observed</div>
						} else {
							<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-1">
								for _, tc := range sortTypeCounts(status.EnemyUnitsSeen) {
									@enemyTypeRow(tc.Type, tc.Count, countOf(status.EnemyUnits, tc.Type))
								}
							</div>
						}
					</div>
				</div>
			</div>
		}
	</div>
}

templ lossCounter(label string, count int) {
	<div class="bg-gray-800 rounded-lg p-3 text-center">
		<div class={ "text-2xl font-mono font-bold", templ.KV("text-red-400", count > 0), templ.KV("text-gray-600", count == 0) }>
			{ fmt.Sprintf("%d", count) }
		</div>
		<div class="text-xs text-gray-500 mt-1">{ label }</div>
	</div>
}

templ enemyTypeRow(typeName string, seenCount int, visibleCount int) {
	<div class="flex items-center justify-between text-sm py-0.5">
		<span class="text-gray-300 truncate">{ rules.DisplayName(typeName) }</span>
		<div class="flex items-center gap-2 shrink-0">
			if visibleCount > 0 {
				<span class="text-emerald-400 font-mono text-xs">{ fmt.Sprintf("%d", visibleCount) } visible</span>
				<span class="text-gray-600">/</span>
			}
			<span class="text-gray-500 font-mono text-xs">{ fmt.Sprintf("%d", seenCount) } seen</span>
		</div>
	</div>
}

templ RecordPanel(wins int, losses int) {
	<div id="record-panel" hx-get="/api/record/panel" hx-trigger="every 10s" hx-swap="outerHTML">
		<div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
			<div class="flex items-center gap-6">
				<div class="flex items-center gap-2">
					<span class="text-emerald-400 text-3xl font-mono font-bold">{ fmt.Sprintf("%d", wins) }</span>
					<span class="text-sm text-gray-500 uppercase">Wins</span>
				</div>
				<span class="text-gray-700 text-2xl">/</span>
				<div class="flex items-center gap-2">
					<span class="text-red-400 text-3xl font-mono font-bold">{ fmt.Sprintf("%d", losses) }</span>
					<span class="text-sm text-gray-500 uppercase">Losses</span>
				</div>
				if wins + losses > 0 {
					<div class="ml-auto text-sm text-gray-500">
						<span class="font-mono text-gray-300">{ fmt.Sprintf("%.0f%%", float64(wins)/float64(wins+losses)*100) }</span> win rate
					</div>
				}
			</div>
		</div>
	</div>
}

func qualityBadgeClass(tag string) string {
	switch tag {
	case "exemplary":
		return "text-xs font-medium text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded-full"
	case "cautionary":
		return "text-xs font-medium text-amber-400 bg-amber-400/10 px-2 py-0.5 rounded-full"
	case "mixed":
		return "text-xs font-medium text-gray-400 bg-gray-400/10 px-2 py-0.5 rounded-full"
	default:
		return "text-xs font-medium text-gray-500 bg-gray-800 px-2 py-0.5 rounded-full"
	}
}

func outcomeClass(won bool) string {
	if won {
		return "text-emerald-400 font-medium"
	}
	return "text-red-400 font-medium"
}

func outcomeLabel(won bool) string {
	if won {
		return "WIN"
	}
	return "LOSS"
}

func relativeAge(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		return fmt.Sprintf("%dm ago", int(d.Minutes()))
	case d < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(d.Hours()))
	default:
		return fmt.Sprintf("%dd ago", int(d.Hours()/24))
	}
}

templ RuleFiringPanel(snap agent.RuleTraceSnapshot) {
	<div id="rule-firing-panel" class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4" hx-get="/api/rules/firings" hx-trigger="every 10s" hx-swap="outerHTML">
		if !snap.Enabled {
			<p class="text-sm text-gray-500">Rule firing trace is disabled. Restart the sidecar with <code class="text-emerald-400">--trace-rules</code> to record per-rule firing counters per doctrine window and see them here.</p>
		} else {
			{{
				totalFired := 0
				for _, s := range snap.Stats {
					totalFired += s.FireCount
				}
				firedSet := make(map[string]bool, len(snap.Stats))
				for name := range snap.Stats {
					firedSet[name] = true
				}
				var neverFired []string
				for _, name := range snap.RuleSet {
					if !firedSet[name] {
						neverFired = append(neverFired, name)
					}
				}
				sort.Strings(neverFired)
				type firedRow struct {
					Name      string
					FireCount int
					FirstTick int
					LastTick  int
				}
				fired := make([]firedRow, 0, len(snap.Stats))
				for name, s := range snap.Stats {
					fired = append(fired, firedRow{name, s.FireCount, s.FirstTick, s.LastTick})
				}
				sort.Slice(fired, func(i, j int) bool { return fired[i].FireCount > fired[j].FireCount })
			}}

			<div class="flex items-center gap-4 text-xs text-gray-500">
				<span><span class="text-gray-300 font-mono">{ fmt.Sprintf("%d", len(snap.RuleSet)) }</span> rules available</span>
				<span>·</span>
				<span><span class="text-emerald-400 font-mono">{ fmt.Sprintf("%d", len(snap.Stats)) }</span> fired</span>
				<span>·</span>
				<span><span class="text-gray-300 font-mono">{ fmt.Sprintf("%d", totalFired) }</span> total firings (current window)</span>
			</div>

			if len(fired) > 0 {
				<div class="space-y-1">
					<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Firings (by count, DESC)</h3>
					<div class="max-h-80 overflow-y-auto pr-2 space-y-0.5">
						for _, r := range fired {
							<div class="flex items-center gap-3 text-sm py-0.5">
								<span class="text-gray-300 font-mono text-xs w-56 truncate" title={ r.Name }>{ r.Name }</span>
								<span class="text-emerald-400 font-mono text-xs w-10 text-right">{ fmt.Sprintf("%d", r.FireCount) }</span>
								<span class="text-gray-500 text-xs">ticks { fmt.Sprintf("%d–%d", r.FirstTick, r.LastTick) }</span>
							</div>
						}
					</div>
				</div>
			}

			if len(neverFired) > 0 {
				<div class="space-y-1">
					<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Available but never fired ({ fmt.Sprintf("%d", len(neverFired)) })</h3>
					<div class="max-h-48 overflow-y-auto pr-2">
						<div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-500 font-mono">
							for _, name := range neverFired {
								<span>{ name }</span>
							}
						</div>
					</div>
				</div>
			}
		}
	</div>
}

templ LibrarianPanel(snap *agent.LibrarianSnapshot) {
	<div id="librarian-panel" class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4" hx-get="/api/memory/librarian" hx-trigger="every 30s" hx-swap="outerHTML">
		if snap == nil {
			<p class="text-sm text-gray-500">Librarian has not run for this game yet. It fires on the first doctrine evaluation once the game starts; if the candidate memory set is empty, no snapshot is produced.</p>
		} else {
			<div class="flex items-center gap-3 text-xs text-gray-500">
				<span>{ snap.OurFaction } vs { snap.OpponentFaction }</span>
				<span>·</span>
				<span>{ relativeAge(snap.GeneratedAt) }</span>
				<span>·</span>
				<span>candidates: { fmt.Sprintf("%d exemplars / %d cautionaries / %d lessons", snap.CandidateExemplars, snap.CandidateCautionaries, snap.CandidateLessons) }</span>
			</div>

			if snap.Directive != "" {
				<div class="text-xs text-gray-500">
					Directive: <span class="text-gray-300 italic">"{ snap.Directive }"</span>
				</div>
			}

			if snap.AlignmentNote != "" {
				<div class="bg-gray-950 border-l-2 border-emerald-500/50 rounded-r p-3">
					<p class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-1">Alignment Note</p>
					<p class="text-sm text-gray-300 leading-relaxed">{ snap.AlignmentNote }</p>
				</div>
			}

			if len(snap.Exemplars) > 0 {
				<div class="space-y-2">
					<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Kept Exemplars ({ fmt.Sprintf("%d", len(snap.Exemplars)) })</h3>
					<ul class="space-y-2">
						for _, e := range snap.Exemplars {
							<li class="border-l-2 border-emerald-500/30 pl-3 py-1">
								<p class="text-sm text-gray-300">{ e.Context }</p>
								<p class="text-xs text-gray-500 font-mono mt-0.5">{ e.DoctrineSummary }</p>
								if e.WhyRelevant != "" {
									<p class="text-sm text-gray-400 mt-1"><span class="text-emerald-400">Why:</span> { e.WhyRelevant }</p>
								}
								if e.WhatToEmulate != "" {
									<p class="text-sm text-gray-400"><span class="text-emerald-400">Emulate:</span> { e.WhatToEmulate }</p>
								}
							</li>
						}
					</ul>
				</div>
			}

			if len(snap.Cautionaries) > 0 {
				<div class="space-y-2">
					<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Cautionary Constraints ({ fmt.Sprintf("%d", len(snap.Cautionaries)) })</h3>
					<ul class="space-y-2">
						for _, c := range snap.Cautionaries {
							<li class="border-l-2 border-amber-500/50 pl-3 py-1">
								<p class="text-sm text-gray-300">{ c.Context }</p>
								<p class="text-xs text-gray-500 font-mono mt-0.5">{ c.FailedPattern }</p>
								if c.WhyRelevant != "" {
									<p class="text-sm text-gray-400 mt-1"><span class="text-amber-400">Why:</span> { c.WhyRelevant }</p>
								}
								if c.WhatToAvoid != "" {
									<p class="text-sm text-gray-400"><span class="text-amber-400">Avoid:</span> { c.WhatToAvoid }</p>
								}
							</li>
						}
					</ul>
				</div>
			}

			if len(snap.Lessons) > 0 {
				<div class="space-y-2">
					<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Kept Lessons ({ fmt.Sprintf("%d", len(snap.Lessons)) })</h3>
					<ul class="space-y-1">
						for _, l := range snap.Lessons {
							<li class="text-sm text-gray-300 border-l-2 border-gray-700 pl-3 py-0.5">
								<span class="text-gray-500">When</span> { l.Trigger } <span class="text-gray-500">→</span> { l.Guidance }
							</li>
						}
					</ul>
				</div>
			}

			if len(snap.Exemplars) == 0 && len(snap.Cautionaries) == 0 && len(snap.Lessons) == 0 {
				<p class="text-sm text-gray-500 italic">Librarian filtered all candidate memory out. See alignment note above.</p>
			}
		}
	</div>
}

templ MemoryPanel(lessons []store.GlobalLesson, games []store.GameSummary) {
	<div id="memory-panel" class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-6" hx-get="/api/memory/panel" hx-trigger="every 30s" hx-swap="outerHTML">
		<!-- Lessons -->
		<div class="space-y-3">
			<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Top Lessons</h3>
			if len(lessons) == 0 {
				<p class="text-sm text-gray-500">No lessons recorded yet. Lessons accumulate after each game's retrospective completes.</p>
			} else {
				<ul class="space-y-2">
					for _, l := range lessons {
						<li class="border-l-2 border-emerald-500/50 pl-3 py-1">
							<div class="flex items-start justify-between gap-3">
								<div class="flex-1 min-w-0">
									<p class="text-sm text-gray-300"><span class="text-emerald-400">When</span> { l.Trigger }</p>
									<p class="text-sm text-gray-400 mt-0.5">→ { l.Guidance }</p>
								</div>
								<span class="shrink-0 text-xs font-mono text-gray-500">{ fmt.Sprintf("%.2f", l.Confidence) }</span>
							</div>
							if l.AppliesFaction != "" {
								<p class="text-xs text-gray-600 mt-1">
									{ l.AppliesFaction }
									if l.AppliesVs != "" && l.AppliesVs != "unknown" {
										<span> vs { l.AppliesVs }</span>
									}
								</p>
							}
						</li>
					}
				</ul>
			}
		</div>

		<!-- Recent Games -->
		<div class="space-y-3">
			<h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Recent Games</h3>
			if len(games) == 0 {
				<p class="text-sm text-gray-500">No archived games yet.</p>
			} else {
				<ul class="space-y-2">
					for _, g := range games {
						<li class="bg-gray-950 border border-gray-800 rounded-lg p-3">
							<div class="flex items-start justify-between gap-3">
								<div class="flex-1 min-w-0">
									<div class="flex items-center gap-2 text-sm">
										<span class={ outcomeClass(g.Won) }>{ outcomeLabel(g.Won) }</span>
										<span class="text-gray-500">·</span>
										<span class="text-gray-300">{ g.OurFaction }</span>
										if g.OpponentFaction != "" && g.OpponentFaction != "unknown" {
											<span class="text-gray-600">vs</span>
											<span class="text-gray-300">{ g.OpponentFaction }</span>
										}
										if g.QualityTag != "" {
											<span class={ qualityBadgeClass(g.QualityTag) }>{ g.QualityTag }</span>
										}
									</div>
									<p class="text-xs text-gray-500 mt-1">
										{ relativeAge(g.PlayedAt) }
										if g.DurationTicks > 0 {
											<span> · { fmt.Sprintf("%d ticks", g.DurationTicks) }</span>
										}
									</p>
									if summary := extractReviewSummary(g.ReviewJSON); summary != "" {
										<p class="text-sm text-gray-400 mt-2 line-clamp-2">{ summary }</p>
									}
								</div>
							</div>
						</li>
					}
				</ul>
			}
		</div>
	</div>
}

// extractReviewSummary pulls the summary field out of a JSON-encoded
// GameReview. A minimal struct avoids pulling the BAML types into the views
// package. Returns "" if the JSON is empty or unparseable.
func extractReviewSummary(reviewJSON string) string {
	if reviewJSON == "" {
		return ""
	}
	var r struct {
		Summary string `json:"summary"`
	}
	if err := json.Unmarshal([]byte(reviewJSON), &r); err != nil {
		return ""
	}
	return r.Summary
}

templ DirectiveForm(current string) {
	<div id="directive-form" class="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
		<h2 class="text-lg font-semibold text-gray-200">Directive</h2>
		<form
			hx-put="/api/directive"
			hx-target="#directive-form"
			hx-swap="outerHTML"
			hx-headers='{"Content-Type": "application/json"}'
			hx-ext="json-enc"
			class="flex flex-col gap-3"
		>
			<textarea
				name="directive"
				rows="3"
				class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-gray-100 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent resize-y"
				placeholder="Enter doctrine directive..."
			>{ current }</textarea>
			<div class="flex justify-end">
				<button
					type="submit"
					class="bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-2 rounded-lg font-medium transition-colors"
				>
					Update
				</button>
			</div>
		</form>
	</div>
}
